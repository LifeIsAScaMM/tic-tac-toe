import tkinter as tk
from tkinter import messagebox

class TicTacToe:
    def __init__(self):
        self.window = tk.Tk()
        self.window.title("Tic Tac Toe")
        self.current_player = "X"
        self.board = [[0] * 3 for _ in range(3)]  # 0: empty, 1: X, 2: O, 3: XO
        self.buttons = [[None] * 3 for _ in range(3)]
        self.create_board()

    def create_board(self):
        for row in range(3):
            for col in range(3):
                button = tk.Button(
                    self.window,
                    text="",
                    font=("Times New Roman", 24),
                    width=3,
                    height=2,
                    command=lambda r=row, c=col: self.make_move(r, c),
                )
                button.grid(row=row, column=col)
                self.buttons[row][col] = button

    def reset_game(self):
        self.current_player = "X"
        self.board = [[0] * 3 for _ in range(3)]
        for row in range(3):
            for col in range(3):
                self.buttons[row][col].config(text="", state=tk.NORMAL)

    def make_move(self, row, col):
        if self.board[row][col] == 3:  # Cell already XO
            return
        if self.board[row][col] == 0:  # Empty cell
            self.board[row][col] = 1 if self.current_player == "X" else 2
            self.buttons[row][col].config(text=self.current_player)
        elif (self.board[row][col] == 1 and self.current_player == "O") or (self.board[row][col] == 2 and self.current_player == "X"):  # Add XO
            self.board[row][col] = 3
            self.buttons[row][col].config(text="XO")
        else:
         	if self.current_player == "X":
         		self.current_player = "O"
         	else:
         		self.current_player = "X"

        if self.check_winner():
            return
        self.current_player = "O" if self.current_player == "X" else "X"

    def check_winner(self):
        for line in self.get_all_lines():
            if self.is_winning_line(line, 1):  # Check for X win
                self.end_game("X wins!")
                return True
            if self.is_winning_line(line, 2):  # Check for O win
                self.end_game("O wins!")
                return True
        return False

    def get_all_lines(self):
        lines = []
        # Rows and columns
        for i in range(3):
            lines.append(self.board[i])  # Rows
            lines.append([self.board[j][i] for j in range(3)])  # Columns
        # Diagonals
        lines.append([self.board[i][i] for i in range(3)])
        lines.append([self.board[i][2 - i] for i in range(3)])
        return lines

    def is_winning_line(self, line, player):
        # Winning conditions
        if player == 1:  # Check for X
            return (
                line == [1, 1, 1] or  # XXX
                line == [1, 3, 1] or  # XOXOX
                line == [1, 3, 3] or
                line == [1, 1, 3] or
                line == [3, 3, 1] or
                line == [3, 1, 1] or
                line == [3, 1, 3] or
                line.count(1) >= 3 and 3 in line
            )
        elif player == 2:  # Check for O
            return (
                line == [2, 2, 2] or  # OOO
                line == [2, 3, 2] or  # XOXOO
                line == [2, 3, 3] or
                line == [2, 2, 3] or
                line == [3, 3, 2] or
                line == [3, 2, 2] or
                line == [3, 2, 3] or
                line.count(2) >= 3 and 3 in line
            )
        return False

    def end_game(self, message):
        messagebox.showinfo("Game Over", message)
        self.reset_game()

    def run(self):
        self.window.mainloop()

if __name__ == "__main__":
    game = TicTacToe()
    game.run()
